# 硅基流动 OpenAI 兼容方式
SILICONFLOW_API_KEY=your_siliconflow_api_key
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
OPENAI_MODEL=Qwen/Qwen3-8B

# 阶段 15 新增：RAG 嵌入模型（独立于聊天模型）
OPENAI_EMBEDDING_MODEL=BAAI/bge-m3

# 阶段 18 新增：数据库（二选一，都不配 = 本地 chat.db）
#   本地开发：不配任何东西，用 node:sqlite 的 chat.db 文件
#   部署（Vercel）：配 Turso 云数据库
# DATABASE_URL=libsql://你的数据库名-你的组织.turso.io
# TURSO_AUTH_TOKEN=你的token

# 阶段 18 新增：向量库（二选一，都不配 = Memory 内存实现）
#   方式 A 自托管：本地 Docker 跑 Chroma（见 Docker速通.md）
# CHROMA_URL=http://localhost:8000
#   方式 B Chroma Cloud 托管：控制台创建后给下面三个值（不用装 Docker）
# CHROMA_CLOUD_API_KEY=你的cloud key
# CHROMA_TENANT=你的tenant
# CHROMA_DATABASE=你的database
